{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@shared-types/*": ["./.shared-types/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.shared-types.json"
    }
  ]
}
